# Copia este archivo como .env.local para desarrollo.
# Usa la URL pooled de Neon (host con -pooler) en DATABASE_URL_POOLED.
DATABASE_URL_POOLED="postgresql://USUARIO:CONTRASENA@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Opcional: conexión directa para tareas administrativas/migraciones.
DATABASE_URL="postgresql://USUARIO:CONTRASENA@HOST.REGION.aws.neon.tech/neondb?sslmode=require"
